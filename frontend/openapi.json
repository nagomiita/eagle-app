{
  "openapi": "3.1.0",
  "info": { "title": "FastAPI", "version": "0.1.0" },
  "servers": [{ "url": "/api" }],
  "paths": {
    "/image/thumbnails": {
      "get": {
        "summary": "Fetch Filtered Thumnail Images",
        "operationId": "fetch_filtered_thumnail_images",
        "parameters": [
          {
            "name": "include_sensitive",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Include Sensitive"
            }
          },
          {
            "name": "favorites_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Favorites Only"
            }
          },
          {
            "name": "selected_tag",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [{ "type": "string" }, { "type": "null" }],
              "title": "Selected Tag"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ThumbnailImage" },
                  "title": "Response Fetch Filtered Thumnail Images"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/image/original": {
      "get": {
        "summary": "Fetch Original Image",
        "operationId": "fetch_original_image",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "title": "Id" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OriginalImage" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/tags/list": {
      "get": {
        "summary": "Fetch Translated Tags",
        "operationId": "fetch_translated_tags",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": { "$ref": "#/components/schemas/Tag" },
                  "type": "array",
                  "title": "Response Fetch Translated Tags"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": { "$ref": "#/components/schemas/ValidationError" },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OriginalImage": {
        "properties": {
          "id": { "type": "string", "title": "Id" },
          "image": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Image"
          }
        },
        "type": "object",
        "required": ["id"],
        "title": "OriginalImage"
      },
      "Tag": {
        "properties": {
          "tag_id": { "type": "integer", "title": "Tag Id" },
          "tag_name": { "type": "string", "title": "Tag Name" },
          "category": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Category"
          },
          "genre": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Genre"
          }
        },
        "type": "object",
        "required": ["tag_id", "tag_name"],
        "title": "Tag"
      },
      "ThumbnailImage": {
        "properties": {
          "id": { "type": "string", "title": "Id" },
          "thumbnail": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Thumbnail"
          }
        },
        "type": "object",
        "required": ["id"],
        "title": "ThumbnailImage"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
            "type": "array",
            "title": "Location"
          },
          "msg": { "type": "string", "title": "Message" },
          "type": { "type": "string", "title": "Error Type" }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    }
  }
}
